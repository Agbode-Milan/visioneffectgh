---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page could not be found.">
  <section class="page-intro page-intro--tall on-dark">
    <div class="wrap">
      <h1>We can't find that page.</h1>
      <p class="lede">It may have moved. Our work and contact details are a click away.</p>
      <div class="actions actions--spaced">
        <a class="btn btn--solid" href="/">Go to home</a>
        <a class="btn btn--ghost" href="/work/">See our work</a>
      </div>
    </div>
  </section>
</Base>
