---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page could not be found.">
  <section class="page-intro page-intro--tall">
    <div class="wrap">
      <h1 data-lines>
        <span class="line"><span>We can't find</span></span>
        <span class="line"><span><em>that page.</em></span></span>
      </h1>
      <p class="lede" data-intro>It may have moved. Our work and contact details are a click away.</p>
      <div class="actions" data-intro>
        <a class="btn btn--yellow" href="/">Go to home</a>
        <a class="btn btn--ghost" href="/work/">See our work</a>
      </div>
    </div>
  </section>
</Base>
