---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import Viewer from '../components/Viewer.astro';
import Cta from '../components/Cta.astro';
import { projects, logos } from '../data/work';
import { services } from '../data/site';
import portrait from '../assets/michael-portrait.jpg';

const byClient = (name) => projects.find((p) => p.client === name);
const heroImages = [byClient('Dyvsi'), byClient("Starly's Smoothies"), byClient('Opt Finance')];
const selected = [
  byClient('Graceland Foods'),
  byClient("Winnie's"),
  byClient('Odo Mineral Water'),
  byClient('Data Appcom Ghana'),
];
---
<Base description="Vision Effects is a branding and print studio in Accra, Ghana. We design logos, packaging and stationery, and produce quality print.">
  <section class="hero on-dark">
    <div class="wrap">
      <div class="hero-copy">
        <div>
          <p class="eyebrow">Branding and print studio in Accra</p>
          <h1>We make businesses look as good as they are.</h1>
        </div>
        <div>
          <p class="lede">Logos, packaging, stationery and print, handled by one team from the first sketch to the final print.</p>
          <div class="actions">
            <a class="btn btn--solid" href="/work/">See our work</a>
            <a class="btn btn--ghost" href="/contact/">Contact us</a>
          </div>
        </div>
      </div>
      <div class="hero-images">
        {heroImages.map((p, i) => (
          <Image
            class={i === 1 ? 'mid' : ''}
            src={p.image}
            alt={p.alt}
            widths={[480, 800, 1200]}
            sizes={i === 1 ? '(max-width: 760px) 100vw, 45vw' : '(max-width: 760px) 50vw, 30vw'}
            format="webp"
            loading="eager"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Selected work</h2>
        <a class="link" href="/work/">View all work</a>
      </div>
      <ul class="work-grid">
        {selected.map((p) => <WorkCard project={p} />)}
      </ul>
    </div>
  </section>

  <section class="section section--band on-dark" aria-label="Clients">
    <div class="wrap">
      <ul class="logo-strip">
        {logos.map((l) => (
          <li><Image src={l.image} alt={l.client} height={136} format="webp" loading="lazy" /></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>What we do</h2>
        <a class="link" href="/services/">Explore our services</a>
      </div>
      <ul class="service-list">
        {services.map((s) => (
          <li>
            <h3>{s.title}</h3>
            <p>{s.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--mist">
    <div class="wrap split">
      <Image
        src={portrait}
        alt="Michael Xorla Domee, CEO and Creative Director of Vision Effects"
        widths={[480, 800, 1200]}
        sizes="(max-width: 820px) 100vw, 45vw"
        format="webp"
        loading="lazy"
      />
      <div>
        <p class="eyebrow">Led by a working designer</p>
        <h2>Your project stays close to the person directing it.</h2>
        <p>Michael Xorla Domee has led Vision Effects since 2017. Trained in graphic design and film editing, he works directly with clients to shape work that fits their business.</p>
        <a class="link" href="/about/">About the studio</a>
      </div>
    </div>
  </section>

  <Cta />
  <Viewer />
</Base>
