---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Viewer from '../components/Viewer.astro';
import Cta from '../components/Cta.astro';
import { projects, logos } from '../data/work';
import { services } from '../data/site';
import { galleryAttrs } from '../data/gallery';
import portrait from '../assets/michael-portrait.jpg';
import cutGraceland from '../assets/cut/graceland.png';
import cutWinnies from '../assets/cut/winnies.png';
import cutWinniesUp from '../assets/cut/winnies-upright.png';
import cutChips from '../assets/cut/graceland-chips.png';
import cutGari from '../assets/cut/graceland-gari.png';
import dyvsiLabel from '../assets/cut/dyvsi-label.jpg';
import cutOdo from '../assets/cut/odo.png';
import cutDyvsi from '../assets/cut/dyvsi.png';
import cutStarlys from '../assets/cut/starlys.png';
import optFinance from '../assets/work/opt-finance.jpg';

// Four panels, five projects, each laid out differently. The rest are on the Work page
const feature = async (name: string) => {
  const project = projects.find((p) => p.client === name)!;
  return { project, gallery: await galleryAttrs(project.image, `${project.client}: ${project.what}`) };
};
const [starlys, grace, winnies, odo, dyvsi] = await Promise.all(["Starly's", 'Graceland', "Winnie's", 'Odo', 'Dyvsi'].map(feature));
// The hero line-up. On wide screens the first four stand in a row; on upright screens all five turn on a ring.
const heroItems = [
  { img: cutWinniesUp, name: "Winnie's", disc: '#f0c02f', size: 0.96, tilt: -3, depth: 45, speed: -0.2, w: [240, 480] },
  { img: cutOdo, name: 'Odo', disc: '#3b2263', size: 1, tilt: 2, depth: 70, speed: -0.42, w: [200, 400] },
  { img: cutStarlys, name: "Starly's", disc: '#a8c83a', size: 0.84, tilt: -2, depth: 40, speed: -0.3, w: [480, 900] },
  { img: cutGraceland, name: 'Graceland', disc: '#f8f4ea', size: 0.86, tilt: 3, depth: 95, speed: -0.14, w: [560, 1000], start: true },
  { img: cutDyvsi, name: 'Dyvsi', disc: '#a8c83a', size: 0.86, tilt: 0, depth: 50, speed: -0.25, w: [400, 700], ringOnly: true },
];
const peeks = { branding: cutDyvsi, packaging: cutGraceland, printing: optFinance, digital: cutStarlys };
---
<Base description="Vision Effects is a branding and print studio in Accra, Ghana. We design logos, packaging and stationery, and produce quality print.">
  <section class="hero" data-hero>
    <div class="wrap hero-copy">
      <div class="hero-products" aria-hidden="true">
        <div class="hero-row">
          <div class="hero-disc"></div>
          {heroItems.map((item) => (
            <div class:list={['float', { 'float--ring': item.ringOnly }]} data-speed={item.speed} data-name={item.name} data-disc={item.disc} data-start={item.start ? '' : undefined} style={`--ar: ${(item.img.width / item.img.height).toFixed(3)}; --size: ${item.size}; --tilt: ${item.tilt}deg;`}>
              <div data-depth={item.depth}><div data-float><Image src={item.img} alt="" widths={item.w} sizes="(max-aspect-ratio: 1/1) 70vw, 30vw" format="webp" loading={item.ringOnly ? 'lazy' : 'eager'} fetchpriority={item.start ? 'high' : undefined} /></div></div>
            </div>
          ))}
          <p class="hero-ring-name"></p>
        </div>
      </div>
      <p class="hero-kicker" data-intro>Branding, packaging and print. Accra.</p>
      <h1 data-lines>
        <span class="line"><span>Brands people</span></span>
        <span class="line"><span><em>reach for.</em></span></span>
      </h1>
      <div class="hero-foot">
        <p data-intro>From the first sketch to the final print, handled by one team.</p>
        <a class="btn btn--yellow magnetic" href="#work" data-intro>See the work</a>
      </div>
    </div>
  </section>

  <section class="statement">
    <div class="wrap">
      <p data-fill>A logo is a promise. Packaging is the proof. Print is what people keep. We design all three, so your brand says one thing, everywhere it appears.</p>
    </div>
  </section>

  <section class="showcase" id="work" aria-label="Selected work">
    <div class="showcase-stage">
      <div class="showcase-progress" aria-hidden="true"><span></span></div>
      <ul class="showcase-track">
        <li class="panel panel--starlys tone-ink">
          <a {...starlys.gallery}>
            <Image src={starlys.project.cut} alt={starlys.project.alt} widths={[800, 1200, 1500]} sizes="(max-width: 900px) 195vw, 100vw" format="webp" loading="lazy" data-drift="3" />
            <span class="panel-caption">
              <span class="panel-title">{starlys.project.client}</span>
              <span class="panel-what">{starlys.project.what}</span>
            </span>
          </a>
        </li>
        <li class="panel panel--grace tone-cream">
          <a {...grace.gallery}>
            <span class="panel-caption">
              <span class="panel-title">{grace.project.client}</span>
              <span class="panel-what">{grace.project.what}</span>
            </span>
            <Image class="pouch pouch--chips" src={cutChips} alt="" widths={[400, 710]} sizes="(max-width: 900px) 68vw, 34vw" format="webp" loading="lazy" data-drift="9" />
            <Image class="pouch pouch--gari" src={cutGari} alt={grace.project.alt} widths={[440, 768]} sizes="(max-width: 900px) 74vw, 38vw" format="webp" loading="lazy" data-drift="20" />
          </a>
        </li>
        <li class="panel panel--duo">
          <a class="duo-winnies tone-yellow" {...winnies.gallery}>
            <span class="panel-caption">
              <span class="panel-title">{winnies.project.client}</span>
              <span class="panel-what">{winnies.project.what}</span>
            </span>
            <Image src={winnies.project.cut} alt={winnies.project.alt} widths={[500, 900, 1258]} sizes="(max-width: 900px) 84vw, 44vw" format="webp" loading="lazy" data-drift="10" />
          </a>
          <a class="duo-odo tone-plum" {...odo.gallery}>
            <span class="panel-caption">
              <span class="panel-title">{odo.project.client}</span>
              <span class="panel-what">{odo.project.what}</span>
            </span>
            <Image src={odo.project.cut} alt={odo.project.alt} widths={[240, 425]} sizes="(max-width: 900px) 30vw, 18vw" format="webp" loading="lazy" data-drift="14" />
          </a>
        </li>
        <li class="panel panel--dyvsi">
          <a {...dyvsi.gallery}>
            <span class="dyvsi-bottles tone-lime">
              <span class="panel-caption">
                <span class="panel-title">{dyvsi.project.client}</span>
                <span class="panel-what">{dyvsi.project.what}</span>
              </span>
              <Image src={dyvsi.project.cut} alt={dyvsi.project.alt} widths={[420, 873]} sizes="(max-width: 900px) 80vw, 42vw" format="webp" loading="lazy" data-drift="7" />
            </span>
            <span class="dyvsi-label">
              <Image src={dyvsiLabel} alt="" width={284} format="webp" loading="lazy" data-drift="5" />
            </span>
          </a>
        </li>
        <li class="panel panel--end tone-yellow">
          <a href="/work/">
            <span class="panel-end-text"><span class="end-wide">See all <em>the work</em></span><span class="end-narrow">See our <em>work</em></span></span>
            <span class="panel-end-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </li>
      </ul>
      <a class="showcase-skip" href="#services">Skip to services <span aria-hidden="true">&darr;</span></a>
    </div>
  </section>

  <section class="section service-index" id="services">
    <div class="wrap">
      <p class="label" data-rise>What we do</p>
      <ul>
        {services.map((s, i) => (
          <li data-rise>
            <a href={`/services/#${s.id}`} data-peek-row={s.id}>
              <span class="service-num" aria-hidden="true">0{i + 1}</span>
              <span class="service-title">{s.title}</span>
              <span class="service-summary">{s.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="service-peek" aria-hidden="true">
      {Object.entries(peeks).map(([id, img]) => (
        <div data-peek={id} class={id === 'printing' ? 'is-photo' : ''}><Image src={img} alt="" width={520} format="webp" loading="lazy" /></div>
      ))}
    </div>
  </section>

  <section class="clients" aria-label="Clients">
    <div class="clients-track">
      {[0, 1].map((n) => (
        <ul aria-hidden={n === 1 ? 'true' : undefined}>
          {logos.map((l) => <li><Image src={l.image} alt={n === 0 ? `${l.client} logo` : ''} height={136} format="webp" loading="lazy" /></li>)}
        </ul>
      ))}
    </div>
  </section>

  <section class="section founder">
    <div class="wrap founder-grid">
      <div class="founder-photo" data-rise>
        <Image data-zoom src={portrait} alt="Michael Xorla Domee, CEO and Creative Director of Vision Effects" widths={[480, 800, 1200]} sizes="(max-width: 820px) 100vw, 45vw" format="webp" loading="lazy" />
      </div>
      <div>
        <p class="label" data-rise>Led by a working designer</p>
        <h2 data-words>Your project stays close to the person directing it.</h2>
        <p class="founder-text" data-rise>Michael Xorla Domee has led Vision Effects since 2017. Trained in graphic design and film editing, he works directly with clients to shape work that fits their business.</p>
        <a class="link" href="/about/" data-rise>About the studio</a>
      </div>
    </div>
  </section>

  <Cta />
  <Viewer />
</Base>
