---
import { Image, getImage } from 'astro:assets';

const { project, loading = 'lazy' } = Astro.props;
const full = await getImage({ src: project.image, width: 1800, format: 'webp' });
---
<li class="work-card" data-category={project.category}>
  <a href={full.src} data-viewer data-caption={`${project.client}: ${project.what}`}>
    <div class="frame">
      <Image
        src={project.image}
        alt={project.alt}
        widths={[480, 800, 1200]}
        sizes="(max-width: 680px) 100vw, 50vw"
        format="webp"
        loading={loading}
      />
    </div>
    <h3>{project.client}</h3>
    <p>{project.what}</p>
  </a>
</li>
